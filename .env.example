# Single shared passphrase gating the whole app (Roger + Sarah).
# Set this in Vercel project env vars for production. Without it the gate is bypassed in local dev.
AGENCY_ZERO_PASSPHRASE=change-me

# --- Shared cloud storage (Supabase) ---
# SERVER-ONLY — never prefix with NEXT_PUBLIC. The confidential state is reachable
# only through the passphrase-gated /api/state route, which uses these on the server.
# Without them the app falls back to per-device localStorage.
SUPABASE_URL=https://ayvpehgikayczgydqsrs.supabase.co
# Prefer the service-role (secret) key from the dashboard for max security;
# the publishable/anon key also works (RLS grants this one table to it).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
